{
  "name": "to-the-stars",
  "private": true,
  "type": "module",
  "version": "1.7.5",
  "scripts": {
    "build": "vitepress build books && mark-magic -t \"卷 01 - 量子纠缠，卷 02 - 宇宙膨胀，卷 03 - 存在悖论，卷 04 - 爱因斯坦 - 罗森桥，番外\" && jszip-cli add dist/epub -o dist/books.zip -f",
    "build-docs": "vitepress build books",
    "deploy": "gh-pages -d ./dist/docs --dotfiles",
    "preview": "pnpm build-docs && live-server dist/docs",
    "dev": "vitepress dev books",
    "update:source": "node scripts/update-source.mjs",
    "fmt": "oxfmt",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "autocorrect": "autocorrect --fix"
  },
  "devDependencies": {
    "@ffflorian/jszip-cli": "^3.16.7",
    "@mark-magic/cli": "latest",
    "@mark-magic/plugin-epub": "latest",
    "@mark-magic/plugin-local": "latest",
    "autocorrect": "^1.2.0",
    "domutils": "^4.0.2",
    "feed": "^6.0.0",
    "gh-pages": "^6.3.0",
    "got": "^16.0.0",
    "html-to-text": "^10.0.1",
    "htmlparser2": "^12.0.0",
    "live-server": "^1.2.2",
    "node-html-parser": "^9.0.4",
    "oxfmt": "latest",
    "oxlint": "latest",
    "oxlint-tsgolint": "latest",
    "pagefind": "^1.5.2",
    "tough-cookie": "^6.0.2",
    "typescript": "^6.0.3",
    "vitepress": "next",
    "vitepress-i18n": "^1.4.0",
    "vitepress-plugin-comment-with-giscus": "^1.1.15",
    "vitepress-plugin-pagefind": "^0.4.25",
    "vitepress-sidebar": "^1.40.0",
    "zx": "^8.8.5"
  }
}
