{
  "name": "to-the-stars",
  "version": "1.7.5",
  "private": true,
  "type": "module",
  "scripts": {
    "autocorrect": "autocorrect --fix",
    "build": "vitepress build .",
    "build-book": "node scripts/build-epub.ts && jszip-cli add dist/epub -o dist/books.zip -f",
    "build-all": "vitepress build . && node scripts/build-epub.ts && jszip-cli add dist/epub -o dist/books.zip -f",
    "deploy": "gh-pages -d ./dist/docs --dotfiles",
    "dev": "vitepress dev .",
    "fmt": "oxfmt",
    "lint:fix": "oxlint --fix",
    "lint": "oxlint",
    "preview": "vitepress preview .",
    "update:source": "node scripts/update-source.ts",
    "update:wiki": "node scripts/update-wiki.ts"
  },
  "devDependencies": {
    "@ffflorian/jszip-cli": "^3.16.8",
    "@types/hast": "^3.0.5",
    "@types/node": "^26.6.3",
    "autocorrect": "^1.2.0",
    "domutils": "^4.0.2",
    "feed": "^6.0.0",
    "gh-pages": "^6.3.0",
    "got": "^16.0.0",
    "hast-util-from-html": "^2.0.3",
    "hast-util-to-html": "^9.0.5",
    "hast-util-to-mdast": "^10.1.2",
    "hpagent": "^1.2.0",
    "html-to-text": "^10.0.1",
    "htmlparser2": "^12.0.0",
    "jszip": "^3.10.2",
    "markdownlint": "^0.41.1",
    "mdast-util-gfm-strikethrough": "^2.0.0",
    "mdast-util-gfm-table": "^2.0.0",
    "mdast-util-to-markdown": "^2.1.2",
    "node-html-parser": "^9.0.4",
    "oxfmt": "latest",
    "oxlint": "latest",
    "oxlint-tsgolint": "latest",
    "pagefind": "^1.5.2",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tough-cookie": "^6.0.2",
    "unified": "^11.0.5",
    "vitepress": "next",
    "vitepress-plugin-comment-with-giscus": "^1.1.15",
    "vitepress-plugin-pagefind": "^0.4.25",
    "vitepress-sidebar": "^1.40.0"
  }
}
