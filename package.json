{
  "name": "to-the-stars",
  "private": true,
  "type": "module",
  "version": "1.7.5",
  "scripts": {
    "build": "mark-magic && jszip-cli add dist/epub -o dist/books.zip -f",
    "build-docs": "mark-magic --task docs",
    "deploy": "gh-pages -d ./dist/docs --dotfiles",
    "preview": "mark-magic --task docs && live-server dist/docs",
    "dev": "vitepress dev books",
    "update:source": "node scripts/update-source.mjs",
    "fmt": "oxfmt",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "autocorrect": "autocorrect --fix"
  },
  "devDependencies": {
    "@ffflorian/jszip-cli": "^3.16.6",
    "@mark-magic/cli": "^0.22.0",
    "@mark-magic/plugin-docs": "^0.22.0",
    "@mark-magic/plugin-epub": "^0.22.2",
    "@mark-magic/plugin-local": "^0.22.0",
    "autocorrect": "^1.2.0",
    "domutils": "^4.0.2",
    "gh-pages": "^6.3.0",
    "got": "^16.0.0",
    "html-to-text": "^10.0.1",
    "htmlparser2": "^12.0.0",
    "live-server": "^1.2.2",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "oxlint-tsgolint": "^7.0.2001",
    "pagefind": "^1.5.2",
    "tough-cookie": "^6.0.2",
    "typescript": "^6.0.3",
    "vitepress": "next",
    "vitepress-i18n": "^1.4.0",
    "vitepress-plugin-pagefind": "^0.4.24",
    "vitepress-sidebar": "^1.40.0",
    "zx": "^8.8.5"
  }
}
