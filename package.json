{
  "name": "to-the-stars",
  "private": true,
  "type": "module",
  "version": "1.7.5",
  "scripts": {
    "autocorrect": "autocorrect --fix",
    "build-docs": "vitepress build books",
    "build": "vitepress build books && node scripts/build-epub.ts && jszip-cli add dist/epub -o dist/books.zip -f",
    "deploy": "gh-pages -d ./dist/docs --dotfiles",
    "dev": "vitepress dev books",
    "fmt": "oxfmt",
    "lint:fix": "oxlint --fix",
    "lint": "oxlint",
    "preview": "vitepress preview books",
    "update:source": "node scripts/update-source.mjs"
  },
  "devDependencies": {
    "@ffflorian/jszip-cli": "^3.16.7",
    "autocorrect": "^1.2.0",
    "domutils": "^4.0.2",
    "feed": "^6.0.0",
    "gh-pages": "^6.3.0",
    "got": "^16.0.0",
    "hast-util-to-html": "^9.0.5",
    "html-to-text": "^10.0.1",
    "htmlparser2": "^12.0.0",
    "jszip": "^3.10.2",
    "node-html-parser": "^9.0.4",
    "oxfmt": "latest",
    "oxlint": "latest",
    "oxlint-tsgolint": "latest",
    "pagefind": "^1.5.2",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tough-cookie": "^6.0.2",
    "unified": "^11.0.5",
    "vitepress": "next",
    "vitepress-i18n": "^1.4.0",
    "vitepress-plugin-comment-with-giscus": "^1.1.15",
    "vitepress-plugin-pagefind": "^0.4.25",
    "vitepress-sidebar": "^1.40.0",
    "zx": "^8.8.5"
  }
}
